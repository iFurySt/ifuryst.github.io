{% assign have_related_posts = false %}
{% assign current_lang = page.lang | default: 'zh' %}
{% if current_lang == 'en' %}
  {% assign related_candidates = site.en_posts | sort: 'date' | reverse %}
{% else %}
  {% assign related_candidates = site.related_posts %}
{% endif %}
{% for post in related_candidates limit: site.related_blog_posts.max_related %}
  {% if post.url == page.url %}
    {% continue %}
  {% endif %}
  {% unless have_related_posts %}
    {% assign have_related_posts = true %}
    <section class="reading-related">
      <h2>{% if current_lang == 'en' %}Keep reading{% else %}继续阅读{% endif %}</h2>
      <ul>
  {% endunless %}

  <li class="my-2">
    <a class="text-pink-700 underline font-semibold hover:text-pink-800" href="{{ site.baseurl }}{{ post.url }}">{{ post.title }}</a>
  </li>
{% endfor %}
{% if have_related_posts %}
      </ul>
    </section>
{% endif %}
{% if site.newsletter.enabled and site.footer_fixed %}
  <p class="mb-2" style="margin-top: 1.5rem !important">Subscribe to be notified of future articles:</p>
  {% include scripts/newsletter.liquid left=true %}
{% endif %}
