{% if include.album.lang == 'en' %}
  {% assign reader_hint = 'Click either side of the pages or use the arrow keys to turn' %}
  {% assign stage_label = 'Book pages; click left to go back, right to go forward' %}
  {% assign drag_hint = 'Click to turn, or hold and drag a page' %}
  {% assign loading_label = 'Loading album…' %}
  {% assign page_label = 'Go to PDF page' %}
  {% assign jump_hint = 'Enter a page number and press Enter' %}
  {% assign noscript_label = 'Enable JavaScript to read this album.' %}
{% else %}
  {% assign reader_hint = '点击页面左右两侧或使用方向键翻页' %}
  {% assign stage_label = '相册页面，点击左侧向前翻，右侧向后翻' %}
  {% assign drag_hint = '点击翻页，或按住页面左右拖动' %}
  {% assign loading_label = '正在加载相册…' %}
  {% assign page_label = '跳转到 PDF 页码' %}
  {% assign jump_hint = '输入页码后按回车跳转' %}
  {% assign noscript_label = '启用 JavaScript 即可在线翻阅。' %}
{% endif %}
<article class="travel-book" id="{{ include.album.id }}">
  {% if include.album.description != empty %}
    <p>{{ include.album.description | escape }}</p>
  {% endif %}
  <section
    class="pdf-reader"
    aria-label="{{ include.album.title | escape }} — {{ reader_hint }}"
    data-lang="{{ include.album.lang | escape }}"
    data-pdf-url="{{ include.album.pdf_url | relative_url | escape }}"
    data-flip-library-url="{{ "/assets/third-party/page-flip/page-flip.js" | relative_url }}"
    data-cover="{{ include.album.pdf_cover }}"
    data-library-url="{{ '/assets/third-party/pdfjs/' | relative_url }}"
  >
    <div class="pdf-stage" tabindex="0" aria-label="{{ stage_label }}" title="{{ drag_hint }}">
      <div class="pdf-pages"></div>
    </div>
    <p class="pdf-status is-visible" role="status" aria-live="polite">{{ loading_label }}</p>
    <footer class="pdf-footer">
      <h3 class="pdf-book-title">{{ include.album.title | escape }}</h3>
      <form class="pdf-page-form">
        <label class="pdf-page-label"
          ><span class="sr-only">{{ page_label }}</span>
          <input type="number" min="1" value="1" aria-label="{{ page_label }}" title="{{ jump_hint }}" disabled>
        </label>
        <span class="pdf-page-count" data-page-count> / —</span>
      </form>
    </footer>
    <noscript>
      <p>{{ noscript_label }}</p>
    </noscript>
  </section>
</article>
